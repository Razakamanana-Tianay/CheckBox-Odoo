# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
build/
dist/

# checkbox runtime state (per-project, never committed from this repo itself)
.checkbox/local.json
.checkbox/.session/

# eval / test output. Leading **/ is required: evals/ lives under
# plugins/checkbox/, and a gitignore pattern containing a non-trailing
# slash is anchored to the .gitignore's own directory, not matched at any
# depth -- "evals/results/" alone silently matched nothing (caught while
# testing P5's first eval run, 2026-09-15).
**/evals/results/
.pytest_cache/
.ruff_cache/

# scratch Odoo source clones
.odoo-src/

# local notes that are kept out of the public repo (working notes, drafts)
/docs/notes/

# local Claude Code session/harness state, not project data
.claude/
